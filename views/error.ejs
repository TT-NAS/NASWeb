<%- include('./partials/_header') %>

  <div class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card p-5 text-center glass-card">
          <h1 class="display-4 text-danger"><%= status %></h1>
          <p class="h3 mt-3"><%= message %></p>
          <p class="mt-2">Si el problema persiste, contacta con el administrador.</p>
          <a href="/" class="btn btn-primary mt-4">Volver al inicio</a>
        </div>
      </div>
    </div>
  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.halo.min.js"></script>
<script>
  VANTA.HALO({
    el: "#body",
    mouseControls: true,
    touchControls: true,
    gyroControls: false,
    minHeight: 200.00,
    minWidth: 200.00,
    scale: 1.00,
    scaleMobile: 1.00,
    color: 0x773ec7,
    backgroundColor: 0x000000
  })
</script>

<%- include('./partials/_footer') %>