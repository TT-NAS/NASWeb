<%- include('./partials/_header') %>

  <%- include('./partials/_nav') %>
  
  <div class="container my-5">
    <div class="row">
      <div class="col">
        <div class="card px-5 py-1 glass-card">
          <!-- Sub grid -->
          <div class="row">
            <div class="col-md d-flex flex-column justify-content-center">
              <p class="h1">
                Tus redes neuronales <span class="text-primary">diseñadas</span> por IA
              </p>
              <p>
                Diseña tus redes neuronales de forma automática. Enfócate en 
                los resultados, ya no te preocupes por el proceso.
              </p>
              <div class="d-grid gap-2 d-md-block mt-5">
                <a class="btn btn-primary px-5" href="/start">Iniciar</a>
                <button class="btn text-white">Más información</button>
              </div>
            </div>
            <div class="col-md d-flex flex-column justify-content-center">
              <img src="/img/principal.png" alt="Logo inicial" class="inicial-image">
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-5 mb-3">
      <div class="col-md">
        <p class="h1">Enfócate en los <span class="text-primary">resultados</span></p>
      </div>
    </div>

    <div class="row row-cols-3 g-4 mb-5">
      <div class="col">
        <div class="card p-4 glass-card h-100">
          <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mt-2 mb-4 fs-4" style="width:45px; height:45px;">
            <i class="bi bi-upload"></i>
          </div>
          <p class="h3">
            Carga tus propios diseños
          </p>
        </div>
      </div>
      <div class="col">
        <div class="card p-4 glass-card h-100">
          <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mt-2 mb-4 fs-4" style="width:45px; height:45px;">
            <i class="bi bi-magic"></i>
          </div>
          <p class="h3">
            Genera las redes
          </p>
        </div>
      </div>
      <div class="col">
        <div class="card p-4 glass-card h-100">
          <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mt-2 mb-4 fs-4" style="width:45px; height:45px;">
            <i class="bi bi-rocket-takeoff"></i>
          </div>
          <p class="h3">
            Listo para el despliegue
          </p>
        </div>
      </div>
    </div>
  </div>
  
  <footer class="bg-primary">
    <div class="container">
      <div class="row py-4">
        <div class="col-6">
          <img src="./img/logo-white.png" alt="Logo" style="height: 60px;" class="rounded me-4">
          Auto segmentation
        </div>
        <div class="col-3">
          <p>
            <a href="#">Informe técnico</a>
          </p>
          <p>
            <a href="#">
              NAS U-Net
            </a>
          </p>
        </div>
        <div class="col-3">
          <p>
            <a href="#">Empezar a generar</a>
          </p>
          <p>
            <a href="#">
              Contáctanos
            </a>
          </p>
        </div>
      </div>
    </div>
  </footer>
  
</body>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.net.min.js"></script>
<script>
  VANTA.NET({
    el: "#body",
    mouseControls: false,
    touchControls: true,
    gyroControls: false,
    minHeight: 200.00,
    minWidth: 200.00,
    scale: 1.00,
    scaleMobile: 1.00,
    color: 0x773ec7,
    backgroundColor: 0x000000
  })
</script>


<%- include('./partials/_footer') %>