<%- include('./partials/_header') %>

  <%- include('./partials/_nav') %>
  
  <div class="container py-5">
    <div class="row">
      <div class="col-md-8">
        <!-- Animation card -->
        <div class="card glass-card p-4">
          <nav class="nav nav-pills flex-column flex-sm-row mb-1">
            <a class="flex-sm-fill text-sm-center nav-link active" aria-current="page" href="#">Arquitectura</a>
            <a class="flex-sm-fill text-sm-center nav-link" href="#">Convergencia</a>
            <a class="flex-sm-fill text-sm-center nav-link" href="#">Frente de pareto</a>
          </nav>
          <div class="card p-1 bg-light" >
            <div id="animation" style="width: auto; height: 300px"></div>
          </div>
        </div>

        <div class="card p-4 glass-card mt-4">
          <!-- Grid in card -->
          <div class="col-md">
            <div>
              <div class="">
                <label for="range-population-size" class="form-label">Tamaño de la población: <output for="range-population-size" id="range-population-size-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="100" value="50" id="range-population-size">
              </div>

              <div class="">
                <label for="range-f" class="form-label">F: <output for="range-f" id="range-f-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="2" step="0.01" value="0.5" id="range-f">
              </div>

              <div class="">
                <label for="range-crossover" class="form-label">Tasa de cruza: <output for="range-crossover" id="range-crossover-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" value="0.5" id="range-crossover">
              </div>

              <div class="">
                <label for="range-mutation" class="form-label">Tasa de mutación: <output for="range-mutation" id="range-mutation-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" value="0.01" id="range-mutation">
              </div>

              <div class="">
                <label for="range-generations" class="form-label">Generaciones: <output for="range-generations" id="range-generations-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="1" max="1000" value="100" id="range-generations">
              </div>

              <div class="d-grid gap-2">
                <button class="btn btn-primary mt-3" id="button-start">Iniciar búsqueda</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col">
        <!-- Results card -->
        <div class="card glass-card p-4">
          <span class="fs-4">Resultados de la búsqueda</span>
          <hr>
          <p>IOU: <span id="result-iou">--</span></p>
          <p>Tiempo de búsqueda: <span id="result-search-time">--</span></p>
          <p>Generación alcanzada: <span id="result-generation">--</span></p>
          <p>Razón de detenimiento: <span id="result-stop-reason">--</span></p>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="button-download" disabled>
              Descargar arquitectura <i class="bi bi-file-earmark-arrow-down-fill"></i>
            </button>
            <ul class="dropdown-menu">
              <li><a href="#" class="dropdown-item" id="a-download-json">.json</a></li>
              <li><a href="#" class="dropdown-item">.pth</a></li>
            </ul>
          </div>
        </div>

        <!-- Training card -->
        <div class="card glass-card p-4 mt-4">
          <span class="fs-4">Entrenamiento de la arquitectura</span>
          <hr>
          <!-- Form -->
          <div>
            <div class="mb-1">
              <label for="form-label">Seleccionar conjunto de datos: </label>
              <select name="dataset" id="dataset-select" class="form-select">
                <option value="road">Caminos</option>
                <option value="car">Carros</option>
              </select>
            </div>
            <div class="mb-1">
              <label for="" class="form-label">Tamaño del dataset:</label>
              <input type="number" value="100" class="form-control" min="10" max="1000" step="100">
            </div>
            <div class="mb-1">
              <label for="" class="form-label">Epocas:</label>
              <input type="number" class="form-control" min="1" max="35" value="10">
            </div>
            <div class="d-grid gap-2 mt-3">
              <button class="btn btn-primary" id="button-training" disabled>Entrenar arquitectura</button>
              <button class="btn btn-outline-primary">Cargar arquitectura <i class="bi bi-file-earmark-arrow-up-fill"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.dots.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.net.min.js"></script>
<script>
  VANTA.DOTS({
    el: "#body",
    mouseControls: true,
    touchControls: true,
    gyroControls: false,
    minHeight: 200.00,
    minWidth: 200.00,
    scale: 1.00,
    scaleMobile: 1.00,
    color: 0x773ec7,
    backgroundColor: 0x000000,
    color2: 0x773ec7
  })

  VANTA.NET({
    el: "#animation",
    mouseControls: true,
    touchControls: true,
    gyroControls: false,
    minHeight: 50.00,
    minWidth: 50.00,
    scale: 1.00,
    scaleMobile: 1.00,
    color: 0xff3f81,
    backgroundColor: 0x000000,
    color2: 0x773ec7
  })
</script>

<%- include('./partials/_footer') %>
<script src="/js/start.form.js"></script>