<%- include('./partials/_header') %>

  <%- include('./partials/_nav') %>

  <link rel="stylesheet" href="/css/animation.css">

  <div class="container py-5">
    <div class="row">
      <div class="col-md-8">
        <!-- Animation card -->
        <div class="card glass-card p-4">
          <nav class="nav nav-pills flex-column flex-sm-row mb-1">
            <a class="flex-sm-fill text-sm-center nav-link active" aria-current="page" href="#" id="navbutton-architecture">Arquitectura</a>
            <a class="flex-sm-fill text-sm-center nav-link" href="#" id="navbutton-chart">Convergencia</a>
            <a class="flex-sm-fill text-sm-center nav-link disabled" href="#" disabled>Frente de pareto</a>
          </nav>
          <div class="card p-1 bg-light" >
            <!-- <div id="animation" class="animation"></div> -->
            <%- include("./partials/_unet_animation") %>
            <canvas id="canvas-chart"></canvas>
          </div>
        </div>

        <div class="card p-4 glass-card mt-4">
          <!-- Grid in card -->
          <div class="col-md">
            <div>
              <div class="">
                <label for="range-population-size" class="form-label"><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Tamaño de la población" data-bs-content="Cantidad de individuos que se evalúan en cada generación del algoritmo."></i> Tamaño de la población: <output for="range-population-size" id="range-population-size-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="100" value="50" id="range-population-size">
              </div>

              <div class="">
                  <label for="range-f" class="form-label"><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Factor de mutación (F)" data-bs-content="Escala la diferencia entre candidatos para generar nuevas soluciones; valores altos exploran más el espacio."></i> F: <output for="range-f" id="range-f-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="2" step="0.01" value="0.5" id="range-f">
              </div>

              <div class="">
                  <label for="range-crossover" class="form-label"><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Tasa de cruza" data-bs-content="Probabilidad de combinar atributos del vector mutado con el actual; equilibra exploración y explotación."></i> Tasa de cruza: <output for="range-crossover" id="range-crossover-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" value="0.5" id="range-crossover">
              </div>

              <div class="">
                  <label for="range-mutation" class="form-label"><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Tasa de mutación" data-bs-content="Probabilidad de alterar genes individuales en los vectores; ayuda a evitar mínimos locales."></i> Tasa de mutación: <output for="range-mutation" id="range-mutation-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="0" max="1" step="0.01" value="0.01" id="range-mutation">
              </div>

              <div class="">
                  <label for="range-generations" class="form-label"><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Generaciones" data-bs-content="Número máximo de iteraciones que ejecutará el algoritmo diferencial en la búsqueda."></i> Generaciones: <output for="range-generations" id="range-generations-value" aria-hidden="true"></output></label>
                <input type="range" class="form-range" min="1" max="1000" value="100" id="range-generations">
              </div>

              <div class="d-grid gap-2">
                <button class="btn btn-primary mt-3" id="button-start">Iniciar búsqueda</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col">
        <!-- Results card -->
        <div class="card glass-card p-4">
          <span class="fs-4">Resultados de la búsqueda</span>
          <hr>
          <p><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Índice IoU" data-bs-content="Intersección sobre Unión: mide la coincidencia entre la predicción segmentada y la máscara real."></i> IOU: <span id="result-iou">--</span></p>
          <p>Tiempo de búsqueda: <span id="result-search-time">--</span> s</p>
          <p>Generación alcanzada: <span id="result-generation">--</span></p>
          <p>Razón de detenimiento: <span id="result-stop-reason">--</span></p>
          <div class="btn-group" role="group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="button-download" disabled>
              Descargar arquitectura <i class="bi bi-file-earmark-arrow-down-fill"></i>
            </button>
            <ul class="dropdown-menu">
              <li><a href="#" class="dropdown-item" id="a-download-json">.json</a></li>
              <li><a href="#" class="dropdown-item">.pth</a></li>
            </ul>
          </div>
        </div>

        <!-- Training card -->
        <div class="card glass-card p-4 mt-4">
          <span class="fs-4">Entrenamiento de la arquitectura</span>
          <hr>
          <nav class="nav nav-pills flex-column flex-sm-row mb-2">
            <a class="flex-sm-fill text-sm-center nav-link active" aria-current="page" href="#button-parameters_train" id="button-parameters_train">Parámetros</a>
            <a class="flex-sm-fill text-sm-center nav-link" href="#button-results_train" id="button-results_train">Resultados</a>
          </nav>
          <!-- Form -->
          <div id="container-train-parameters" class="">
            <div class="mb-1">
              <label for="form-label">Seleccionar conjunto de datos: </label>
              <select name="dataset" id="select-dataset" class="form-select">
                <option value="road" default>Caminos</option>
                <option value="car">Carros</option>
              </select>
            </div>
            <div class="mb-1">
              <label for="" class="form-label">Tamaño del dataset:</label>
              <input type="number" value="100" class="form-control" min="10" max="1000" step="100" id="number-dataset-size">
            </div>
            <div class="mb-1">
              <label for="" class="form-label">Epocas:</label>
              <input type="number" class="form-control" min="1" max="35" value="2" id="number-epochs">
            </div>
            <div class="d-grid gap-2 mt-3">
              <button class="btn btn-primary" id="button-training" disabled>Entrenar arquitectura</button>
              <button class="btn btn-outline-primary" id="button-load_architecture">Cargar arquitectura <i class="bi bi-file-earmark-arrow-up-fill"></i></button>
              <input type="file" class="d-none" id="file-chromosoma" accept=".json">
            </div>
          </div>
          <div class="" id="container-train-results">
            <p><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Índice IoU (train)" data-bs-content="Coincidencia entre la segmentación generada durante el entrenamiento y el objetivo esperado."></i> IOU de entrenamiento: <span id="result-train-iou">--</span></p>
            <p><i class="bi bi-info-circle" role="button" tabindex="0" data-bs-container="body" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-title="Índice IoU (validación)" data-bs-content="Coincidencia entre la segmentación generada en validación y la máscara real del conjunto de validación."></i> IOU de validación: <span id="result-train-iou_val">--</span></p>
            <p>Tiempo de entrenamiento: <span id="result-train-time">--</span> s</p>
            <p>Epoca alcanzada: <span id="result-train-epoch">--</span></p>
          </div>
        </div>
      </div>
    </div>

  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.dots.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.net.min.js"></script>
